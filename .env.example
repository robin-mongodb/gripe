# Copy to .env for local dev; do NOT commit .env
# Backend selector — one of: mongo, postgres
GRIPE_BACKEND=mongo

# Atlas (managed) — required when GRIPE_BACKEND=mongo
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=gripe

# Aurora (managed) — required when GRIPE_BACKEND=postgres
# Use the writer endpoint for read-your-writes correctness.
PG_WRITER_DSN=postgres://user:pass@cluster.rds.amazonaws.com:5432/gripe?sslmode=require
PG_READER_DSN=postgres://user:pass@cluster.rds.amazonaws.com:5432/gripe?sslmode=require

# SQS
AWS_REGION=eu-west-1
SQS_PAYMENT_CREATED_URL=https://sqs.eu-west-1.amazonaws.com/000000000000/payment-created
# fraud + fee workers each subscribe to their own queue fanned from the above via SNS,
# or the api double-publishes. Set once we wire it.
SQS_FRAUD_URL=
SQS_FEE_URL=

# API
API_ADDR=:8080

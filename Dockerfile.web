FROM node:20-alpine AS build
WORKDIR /src
COPY web/ ./
RUN npm ci || npm install
RUN npm run build

FROM node:20-alpine
WORKDIR /app
COPY --from=build /src/.next ./.next
COPY --from=build /src/package.json ./
COPY --from=build /src/node_modules ./node_modules
# ponytail: no web/public dir yet — add COPY --from=build /src/public ./public when static assets land.
EXPOSE 3000
CMD ["npm", "start"]
